# Application
NEXT_PUBLIC_APP_NAME=Platform
NEXT_PUBLIC_BASE_URL=https://vuohiliitto.com

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/platform

# NextAuth
AUTH_SECRET=          # Generate with: openssl rand -base64 32

# Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub OAuth
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Cron job authentication
CRON_SECRET=          # Generate with: openssl rand -base64 32

# HRM application URL (for user management)
NEXT_PUBLIC_HRM_URL=http://localhost:3000

# Set to "false" to hide the demo login button
NEXT_PUBLIC_DEMO_LOGIN=true

# GitHub personal access token for Dev Log commit feed (optional; increases rate limit from 60 to 5000 req/hour)
GITHUB_TOKEN=
