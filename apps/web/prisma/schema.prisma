generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  name               String?
  alias              String?   @unique
  image              String?
  avatarUrl          String?
  bio                String?
  role               String    @default("pending")
  wantsToDevelop     Boolean   @default(false)
  developerTag       String?
  developmentSkills  String[]  @default([])
  hasSeenPromotion   Boolean   @default(true)
  permissionsVersion Int       @default(0)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  posts          Post[]
  topics         Topic[]
  threads        Thread[]
  calendarEvents CalendarEvent[]
  permissions    UserPermission[]
  shouts         Shout[]
  issueReports    IssueReport[]
  surveyResponses SurveyResponse[]
  xpTransactions     XpTransaction[]
  userLevel          UserLevel?
  achievements       UserAchievement[]
  questProgress      UserQuestProgress[]
  loginStreak        LoginStreak?
  tourProgress       UserTourProgress[]
  demoSessions       DemoSession[]
  assignedQuests     Quest[]           @relation("QuestAssignee")
  createdQuests      Quest[]           @relation("QuestCreator")
  createdSurveyRounds SurveyRound[]   @relation("SurveyRoundCreator")
  conversationsAsA    Conversation[]   @relation("ConversationParticipantA")
  conversationsAsB    Conversation[]   @relation("ConversationParticipantB")
  sentDirectMessages  DirectMessage[]  @relation("DirectMessageSender")
  feedbacks           Feedback[]       @relation("FeedbackAuthor")
  feedbackReplies     Feedback[]       @relation("FeedbackAdmin")
  wowCharacters       WowCharacter[]
  mythicPlusTeams     MythicPlusTeam[]

  sessionId      String?

  @@index([deletedAt])
  @@index([email])
  @@index([sessionId])
}

// ─── Permissions ──────────────────────────────────────────────────────────────

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String?
  users       UserPermission[]
}

model UserPermission {
  id           String  @id @default(uuid())
  userId       String
  permissionId String
  granted      Boolean @default(true)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
}

// ─── Board System ────────────────────────────────────────────────────────────

model Board {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  tenant      String    @default("vuohiliitto")
  sessionId   String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  posts Post[]

  @@index([deletedAt])
  @@index([sortOrder])
  @@index([sessionId])
  @@index([tenant])
}

model Post {
  id        String    @id @default(uuid())
  title     String
  slug      String
  body      String
  pinned    Boolean   @default(false)
  authorId  String
  boardId   String
  tenant    String    @default("vuohiliitto")
  sessionId String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  board  Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([boardId, slug])
  @@index([deletedAt])
  @@index([authorId])
  @@index([boardId])
  @@index([pinned])
  @@index([createdAt])
  @@index([sessionId])
  @@index([tenant])
}

// ─── Forum System ────────────────────────────────────────────────────────────

model Forum {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  tenant      String    @default("vuohiliitto")
  sessionId   String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  topics Topic[]

  @@index([deletedAt])
  @@index([sortOrder])
  @@index([sessionId])
  @@index([tenant])
}

model Topic {
  id        String    @id @default(uuid())
  title     String
  slug      String
  body      String
  pinned    Boolean   @default(false)
  locked    Boolean   @default(false)
  authorId  String
  forumId   String
  tenant    String    @default("vuohiliitto")
  sessionId String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  forum  Forum @relation(fields: [forumId], references: [id], onDelete: Cascade)

  @@unique([forumId, slug])
  @@index([deletedAt])
  @@index([authorId])
  @@index([forumId])
  @@index([pinned])
  @@index([createdAt])
  @@index([sessionId])
  @@index([tenant])
}

// ─── Unified Thread/Reply System ─────────────────────────────────────────────

enum ParentType {
  POST
  TOPIC
}

model Thread {
  id         String     @id @default(uuid())
  body       String
  parentType ParentType
  parentId   String
  authorId   String
  replyToId  String?
  tenant     String     @default("vuohiliitto")
  sessionId  String?
  deletedAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  author  User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replyTo Thread?  @relation("ThreadReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies Thread[] @relation("ThreadReplies")

  @@index([parentType, parentId])
  @@index([deletedAt])
  @@index([authorId])
  @@index([replyToId])
  @@index([createdAt])
  @@index([sessionId])
  @@index([tenant])
}

// ─── Calendar System ─────────────────────────────────────────────────────────

model CalendarEvent {
  id          String    @id @default(uuid())
  title       String
  description String?
  location    String?
  startTime   DateTime
  endTime     DateTime
  allDay      Boolean   @default(false)
  authorId    String?
  tenant      String    @default("vuohiliitto")
  sessionId   String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([deletedAt])
  @@index([authorId])
  @@index([startTime, endTime])
  @@index([sessionId])
  @@index([tenant])
}

// ─── Shoutbox ───────────────────────────────────────────────────────────────

model Shout {
  id        String   @id @default(uuid())
  message   String
  authorId  String
  tenant    String   @default("vuohiliitto")
  sessionId String?
  createdAt DateTime @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([authorId])
  @@index([sessionId])
  @@index([tenant])
}

// ─── Issue Reports ──────────────────────────────────────────────────────────

model IssueReport {
  id          String    @id @default(uuid())
  title       String
  description String
  url         String?
  authorId    String
  tenant      String    @default("vuohiliitto")
  sessionId   String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([authorId])
  @@index([resolvedAt])
  @@index([sessionId])
  @@index([tenant])
}

// ─── Rate Limiting ──────────────────────────────────────────────────────────

model RateLimit {
  id          String   @id @default(uuid())
  identifier  String
  action      String
  count       Int      @default(1)
  windowStart DateTime @default(now())

  @@unique([identifier, action])
  @@index([windowStart])
}

// ─── Survey ─────────────────────────────────────────────────────────────────

model SurveyRound {
  id              String    @id @default(uuid())
  number          Int       @unique
  title           String
  description     String?
  status          String    @default("active")
  xpReward        Int       @default(0)
  customQuestions  Json?
  deadline        DateTime?
  creatorId       String
  tenant          String    @default("vuohiliitto")
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  responses SurveyResponse[]
  quests    Quest[]          @relation("SurveyRoundQuests")
  creator   User             @relation("SurveyRoundCreator", fields: [creatorId], references: [id])

  @@index([status])
  @@index([creatorId])
  @@index([tenant])
}

model SurveyResponse {
  id                String   @id @default(uuid())
  conversationStyle String
  features          String[]
  mustHave          String
  dealbreaker       String?
  otherFeedback     String?
  wantsToDevelop    Boolean   @default(false)
  developmentSkills String[]  @default([])
  customAnswers     Json?
  userId            String?
  roundId           String?
  tenant            String    @default("vuohiliitto")
  sessionId         String?
  submittedAt       DateTime @default(now())

  author User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  round  SurveyRound? @relation(fields: [roundId], references: [id])

  @@index([submittedAt])
  @@index([userId])
  @@index([roundId])
  @@index([sessionId])
  @@index([tenant])
}

// ─── Feedback ───────────────────────────────────────────────────────────────

model Feedback {
  id             String    @id @default(uuid())
  message        String
  authorId       String
  adminReply     String?
  adminReplyById String?
  adminRepliedAt DateTime?
  tenant         String    @default("vuohiliitto")
  sessionId      String?
  createdAt      DateTime  @default(now())

  author      User  @relation("FeedbackAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  adminReplyBy User? @relation("FeedbackAdmin", fields: [adminReplyById], references: [id], onDelete: SetNull)

  @@index([authorId])
  @@index([createdAt])
  @@index([sessionId])
  @@index([tenant])
}

// ─── WoW Mythic+ Tracking ─────────────────────────────────────────────────

model WowCharacter {
  id               String    @id @default(uuid())
  characterName    String
  realm            String
  region           String
  className        String?
  spec             String?
  specRole         String?
  race             String?
  itemLevel        Float?
  mythicPlusRating Float?
  thumbnailUrl     String?
  profileUrl       String?
  lastFetchedAt    DateTime?
  addedById        String
  tenant           String    @default("vuohiliitto")
  sessionId        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  addedBy User @relation(fields: [addedById], references: [id], onDelete: Cascade)

  teamTank    MythicPlusTeam[] @relation("TeamTank")
  teamHealer  MythicPlusTeam[] @relation("TeamHealer")
  teamDps1    MythicPlusTeam[] @relation("TeamDps1")
  teamDps2    MythicPlusTeam[] @relation("TeamDps2")
  teamDps3    MythicPlusTeam[] @relation("TeamDps3")

  @@unique([characterName, realm, region, sessionId])
  @@index([addedById])
  @@index([sessionId])
  @@index([tenant])
}

model MythicPlusTeam {
  id        String   @id @default(uuid())
  name      String
  tankId    String?
  healerId  String?
  dps1Id    String?
  dps2Id    String?
  dps3Id    String?
  creatorId String
  tenant    String   @default("vuohiliitto")
  sessionId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tank    WowCharacter? @relation("TeamTank", fields: [tankId], references: [id], onDelete: SetNull)
  healer  WowCharacter? @relation("TeamHealer", fields: [healerId], references: [id], onDelete: SetNull)
  dps1    WowCharacter? @relation("TeamDps1", fields: [dps1Id], references: [id], onDelete: SetNull)
  dps2    WowCharacter? @relation("TeamDps2", fields: [dps2Id], references: [id], onDelete: SetNull)
  dps3    WowCharacter? @relation("TeamDps3", fields: [dps3Id], references: [id], onDelete: SetNull)
  creator User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@index([sessionId])
  @@index([tenant])
}

// ─── Gamification ──────────────────────────────────────────────────────────

model XpTransaction {
  id        String   @id @default(uuid())
  userId    String
  amount    Int
  source    String
  sourceId  String?
  tenant    String   @default("vuohiliitto")
  sessionId String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([source])
  @@index([userId, source])
  @@index([sessionId])
  @@index([tenant])
}

model UserLevel {
  id        String   @id @default(uuid())
  userId    String   @unique
  totalXp   Int      @default(0)
  level     Int      @default(1)
  tenant    String   @default("vuohiliitto")
  sessionId String?
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([level])
  @@index([totalXp])
  @@index([sessionId])
  @@index([tenant])
}

model Achievement {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String
  icon        String
  tier        String?
  category    String
  xpReward    Int      @default(0)
  criteria    Json
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  tenant        String   @default("vuohiliitto")
  sessionId     String?
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([sessionId])
  @@index([tenant])
}

model Quest {
  id            String    @id @default(uuid())
  key           String?   @unique
  name          String
  description   String?
  icon          String?
  type          String
  xpReward      Int
  criteria      Json?
  repeatable    Boolean   @default(false)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  priority      String    @default("normal")
  targetSkill   String?
  assigneeId    String?
  creatorId     String?
  surveyRoundId String?
  deadline      DateTime?
  status        String    @default("active")
  completedAt   DateTime?
  deletedAt     DateTime?
  tenant        String    @default("vuohiliitto")
  sessionId     String?
  updatedAt     DateTime  @default(now()) @updatedAt

  userProgress  UserQuestProgress[]
  assignee      User?         @relation("QuestAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  creator       User?         @relation("QuestCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  surveyRound   SurveyRound?  @relation("SurveyRoundQuests", fields: [surveyRoundId], references: [id])

  @@index([assigneeId])
  @@index([creatorId])
  @@index([status])
  @@index([deletedAt])
  @@index([sessionId])
  @@index([surveyRoundId])
  @@index([tenant])
}

model UserQuestProgress {
  id          String    @id @default(uuid())
  userId      String
  questId     String
  progress    Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  resetAt     DateTime?
  tenant      String    @default("vuohiliitto")
  sessionId   String?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
  @@index([userId])
  @@index([completed])
  @@index([sessionId])
  @@index([tenant])
}

model LoginStreak {
  id            String   @id @default(uuid())
  userId        String   @unique
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastLoginDate DateTime
  tenant        String   @default("vuohiliitto")
  sessionId     String?
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([tenant])
}

// ─── Demo Mode ────────────────────────────────────────────────────────────

model DemoSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  @@index([userId])
  @@index([lastActiveAt])
}

// ─── Guided Tour ───────────────────────────────────────────────────────────

model UserTourProgress {
  id          String   @id @default(uuid())
  userId      String
  stepId      String
  tenant      String   @default("vuohiliitto")
  sessionId   String?
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, stepId])
  @@index([userId])
  @@index([sessionId])
  @@index([tenant])
}

// ─── Audit Log ───────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String?
  actorId    String
  actorName  String?
  details    Json?
  tenant     String   @default("vuohiliitto")
  sessionId  String?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([entityType])
  @@index([actorId])
  @@index([createdAt])
  @@index([sessionId])
  @@index([tenant])
}

// ─── Platform Settings ────────────────────────────────────────────────────

model PlatformSetting {
  key       String
  tenant    String   @default("vuohiliitto")
  value     String
  updatedAt DateTime @updatedAt

  @@id([tenant, key])
}

// ─── Direct Messages ──────────────────────────────────────────────────────

model Conversation {
  id            String    @id @default(uuid())
  participantA  String
  participantB  String
  isPrivacy     Boolean   @default(false)
  lastMessageAt DateTime  @default(now())
  tenant        String    @default("vuohiliitto")
  sessionId     String?
  createdAt     DateTime  @default(now())

  userA    User             @relation("ConversationParticipantA", fields: [participantA], references: [id], onDelete: Cascade)
  userB    User             @relation("ConversationParticipantB", fields: [participantB], references: [id], onDelete: Cascade)
  messages DirectMessage[]

  @@unique([participantA, participantB, sessionId])
  @@index([participantA])
  @@index([participantB])
  @@index([lastMessageAt])
  @@index([sessionId])
  @@index([tenant])
}

model DirectMessage {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  message        String
  readAt         DateTime?
  tenant         String    @default("vuohiliitto")
  sessionId      String?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("DirectMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([sessionId])
  @@index([tenant])
}
